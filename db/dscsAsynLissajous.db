record(ai, "$(P)$(R)LISS_FREQ_RBV_X")
{
    field(DESC, "Lissajous frequency X readback")
    field(DTYP, "asynFloat64")
    field(PREC, "$(PREC=3)")
    field(EGU , "kHz")
    field(LOPR, "0")
    field(HOPR, "20.21")
    field(INP , "@asyn($(PORT),$(ADDR))LISS_FREQ_RBV_X")
    field(SCAN, "I/O Intr")
}

